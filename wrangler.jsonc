{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "spellsplice",
    "compatibility_date": "2026-07-21",
    "routes": [{ "pattern": "app.spellsplice.com", "custom_domain": true }],

    // Assets-only Worker: no "main", no ASSETS binding. Client routes like
    // /overlay have no file on disk, so a direct load (OBS Browser Source,
    // refresh) needs the host to hand back the app shell with a 200.
    // main.tsx then renders the right screen from window.location.pathname.
    "assets": {
        "directory": "./dist/",
        "not_found_handling": "single-page-application"
    },

    // `assets` and `routes` are inheritable, so env.beta picks up the asset
    // config above. Deployed as a separate Worker named "spellsplice-beta".
    // custom_domain routes make wrangler create the DNS record and issue the
    // certificate on deploy.
    "env": {
        "beta": {
            "routes": [{ "pattern": "beta.spellsplice.com", "custom_domain": true }]
        }
    }
}
